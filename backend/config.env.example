# Copy to backend/config.env for local development.
# On Render (or any host) set these as environment variables instead.

NODE_ENV=development
PORT=5000

# MongoDB Atlas free (M0) cluster connection string
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/hospital_management

# Use two different long random strings
JWT_SECRET=change_me_to_a_long_random_string
JWT_REFRESH_SECRET=change_me_to_a_different_long_random_string
JWT_EXPIRE=30d

# Frontend URL(s) allowed to call the API, comma-separated
CLIENT_URL=http://localhost:3000

# true on the public live demo: blocks deletes, user management and password changes
DEMO_MODE=false
